# Fieldkit needs no account and no telemetry for its decision path.
# Everything it decides happens on your machine.
#
# The only thing this key is for is the optional follow-up explanation,
# which is the one part of the tool that can talk to a hosted model.
# Leave it blank and Fieldkit uses a local model instead (see
# `fieldkit llm status`).
GOOGLE_AI_STUDIO_API_KEY=
